{
  "id": "swap-buy-flagged-code-token",
  "schema_version": 2,
  "trigger": {
    "where": {
      "action.tag": {
        "eq": "swap"
      }
    }
  },
  "policy_rpc": [
    {
      "id": "out-token-sec",
      "method": "token.security_flags",
      "params": {
        "chain_id": "$.root.chain_id",
        "token": "$.action.tokenOut.key.address"
      },
      "outputs": [
        {
          "kind": "context",
          "field": "tokenCodeTraits",
          "type": "Set<String>",
          "from": "$.result.tokenCodeTraits",
          "required": false
        }
      ],
      "optional": true
    }
  ],
  "custom_context": {
    "fields": {
      "tokenCodeTraits": "Set<String>"
    }
  },
  "_template": {
    "codeTraits": {
      "cedar_set": "[\"closed_source\"]",
      "default": "closed_source",
      "meaning": "Contract traits that trigger the warning. Choices: closed_source, proxy. Measured on ETH Uniswap V2 WETH pools 2023-06..2026-08, normal = pools alive and trading at day 30 (research s15/s16): closed_source → normal tokens 0.9%; + proxy → 1.6%."
    }
  }
}
