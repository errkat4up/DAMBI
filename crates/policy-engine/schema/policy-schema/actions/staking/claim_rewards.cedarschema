// Staking::ClaimRewards — mint accrued reward tokens for one or more gauges
// (Curve `Minter.mint` / `mint_for` / `mint_many` and Aave claims).
//
// Rust source: `crates/asset-model/action/src/staking/claim_rewards.rs`
// (`ClaimRewardsAction`). No LiveInputs.

namespace Staking {
  type ClaimRewardsContext = {
    meta: Core::ActionMeta,
    venue: StakeVenue,
    // Reward token (CRV for the Minter); omitted for a gauge's multi-reward claim_rewards.
    rewardToken?: Core::TokenRef,
    // Gauge or Umbrella stake-token address(es) whose rewards are claimed; empty
    // for a gauge's own claim_rewards (the gauge is the venue). Each a hex address.
    gauges: Set<String>,
    // Beneficiary whose rewards are claimed (`mint_for._for` / `claim_rewards(_addr)`).
    onBehalfOf?: String,
    // Final beneficiary of reward tokens or resulting stake shares.
    recipient?: String,
    // Requested reinvestment of eligible rewards; not proof of execution.
    // Aave Umbrella pays rewards without a supported staking path to the beneficiary.
    restake?: Bool,
    custom?: ClaimRewardsCustomContext,
  };

  type ClaimRewardsCustomContext = {};

  action "ClaimRewards" appliesTo {
    principal: Wallet,
    resource: Protocol,
    context: ClaimRewardsContext,
  };
}
