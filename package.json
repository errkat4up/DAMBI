{
  "name": "dambi",
  "private": true,
  "license": "Apache-2.0",
  "description": "Dambi monorepo — Rust backend (crates/), browser extension. Frontend lives in browser-extension/dashboard/ for now.",
  "packageManager": "yarn@4.14.1",
  "scripts": {
    "server:local": "bash scripts/start-policy-server.sh local",
    "server:ext": "bash scripts/start-policy-server.sh ext",
    "core:typecheck": "yarn workspace @dambi/core typecheck",
    "core:build": "yarn workspace @dambi/core build",
    "core:pack": "yarn workspace @dambi/core pack:check",
    "decoder:test": "node --test fixtures/decoder-policy/approve.test.mjs"
  },
  "workspaces": [
    "packages/*"
  ]
}
