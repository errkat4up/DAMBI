{
  "name": "dambi",
  "private": true,
  "license": "Apache-2.0",
  "description": "Dambi monorepo \u2014 Rust backend (crates/), browser extension. Frontend lives in browser-extension/dashboard/ for now.",
  "packageManager": "yarn@4.14.1",
  "scripts": {
    "server:local": "bash scripts/start-policy-server.sh local",
    "server:ext": "bash scripts/start-policy-server.sh ext",
    "core:typecheck": "yarn workspace @dambi/core typecheck",
    "core:build": "yarn workspace @dambi/core build",
    "core:pack": "yarn workspace @dambi/core pack:check",
    "decoder:test": "node --test fixtures/decoder-policy/approve.test.mjs fixtures/decoder-policy/approve-policy.test.mjs fixtures/decoder-policy/transfer.test.mjs fixtures/decoder-policy/typed-permit.test.mjs fixtures/decoder-policy/typed-permit-strict.test.mjs fixtures/decoder-policy/permit2-single.test.mjs fixtures/decoder-policy/permit2-batch.test.mjs fixtures/decoder-policy/multicall-self.test.mjs fixtures/decoder-policy/multicall-call-array.test.mjs fixtures/decoder-policy/multicall-limits.test.mjs",
    "decoder:test:approve": "node --test fixtures/decoder-policy/approve.test.mjs",
    "decoder:test:approve-policy": "node --test fixtures/decoder-policy/approve-policy.test.mjs",
    "decoder:test:transfer": "node --test fixtures/decoder-policy/transfer.test.mjs",
    "decoder:test:typed-permit": "node --test fixtures/decoder-policy/typed-permit.test.mjs",
    "decoder:test:typed-permit-strict": "node --test fixtures/decoder-policy/typed-permit-strict.test.mjs",
    "decoder:test:permit2-single": "node --test fixtures/decoder-policy/permit2-single.test.mjs",
    "decoder:test:permit2-batch": "node --test fixtures/decoder-policy/permit2-batch.test.mjs",
    "decoder:test:multicall-self": "node --test fixtures/decoder-policy/multicall-self.test.mjs",
    "decoder:test:multicall-call-array": "node --test fixtures/decoder-policy/multicall-call-array.test.mjs",
    "decoder:test:multicall-limits": "node --test fixtures/decoder-policy/multicall-limits.test.mjs",
    "decoder:test:handoff": "node --test fixtures/decoder-policy/handoff.test.mjs",
    "decoder:build:handoff": "node fixtures/decoder-policy/build-handoff.mjs"
  },
  "workspaces": [
    "packages/*"
  ]
}
